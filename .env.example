# Copy to .env and fill in. Never commit .env.

# ── LLM router (shared local LiteLLM proxy, free providers with fallback) ──
# Values below are for running the backend directly on your machine;
# docker-compose overrides the hostnames for containers.
LLM_ROUTER_URL=http://localhost:4000/v1
# Must match LITELLM_MASTER_KEY in the LLM-Router's .env
LLM_ROUTER_KEY=

# ── Database ──
POSTGRES_USER=finops
POSTGRES_PASSWORD=finops
POSTGRES_DB=finops
DATABASE_URL=postgresql+asyncpg://finops:finops@localhost:5433/finops

# ── Redis (job queue) ──
REDIS_URL=redis://localhost:6379/0

# ── Object storage (SeaweedFS locally; any S3-compatible store in prod) ──
S3_ENDPOINT=http://localhost:9100
# Endpoint the browser uses for pre-signed download URLs
S3_PUBLIC_ENDPOINT=http://localhost:9100
S3_ACCESS_KEY=finops
S3_SECRET_KEY=finops-secret
S3_BUCKET=invoices

# ── Auth ──
# Any long random string. Used to sign dev/demo JWTs.
JWT_SECRET=change-me-to-a-long-random-string

# ── Frontend ──
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
